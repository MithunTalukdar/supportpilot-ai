# Backend Environment Configuration Template
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportpilot_db?schema=public"

# Authentication & JWT Secrets (Placeholders only)
JWT_SECRET=your-jwt-secret-min-32-chars-long-placeholder
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars-long-placeholder
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=info
