# ==============================================================================
# SupportPilot AI — Backend Production Environment Template
# ==============================================================================
# Populate these variables in your backend hosting service (Render, AWS, Railway, etc.)
# ==============================================================================

NODE_ENV=production
PORT=5000

# Canonical URLs & Origins
FRONTEND_URL=https://app.supportpilot.ai
CORS_ALLOWED_ORIGINS=https://app.supportpilot.ai,https://supportpilot.ai

# Database (PostgreSQL 15+ with pgvector)
# Use sslmode=require for cloud-hosted databases (AWS RDS, Supabase, Neon)
DATABASE_URL="postgresql://supportpilot_admin:SECURE_STRONG_DB_PASSWORD@db-host:5432/supportpilot_prod?schema=public&sslmode=require"

# Authentication & Cryptographic Keys (Generate with `openssl rand -hex 32`)
JWT_SECRET=generate-a-strong-random-64-character-hex-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=generate-a-separate-strong-random-64-character-hex-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Production Cookie Policy
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
COOKIE_DOMAIN=.supportpilot.ai

# Logging Level
LOG_LEVEL=info

# AI Provider Gateway
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-placeholder-in-cloud-settings
GEMINI_API_KEY=placeholder-in-cloud-settings
ANTHROPIC_API_KEY=placeholder-in-cloud-settings
