# ==============================================================================
# SupportPilot AI — Production Environment Variables Reference
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials, database passwords, or secret keys to Git.
# - Supply these variables securely in your hosting provider's dashboard
#   (e.g., Render Environment Variables, AWS Secrets Manager, Vercel Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Production Settings (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Canonical URLs (No trailing slashes)
FRONTEND_URL=https://app.supportpilot.ai
CORS_ALLOWED_ORIGINS=https://app.supportpilot.ai,https://supportpilot.ai

# Database Connection (PostgreSQL 15+ with pgvector enabled)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&sslmode=require
DATABASE_URL="postgresql://supportpilot_admin:SECURE_STRONG_DB_PASSWORD@db.production.internal:5432/supportpilot_production?schema=public&sslmode=require"

# JWT Token Cryptographic Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=generate-a-strong-random-64-character-hex-string-for-jwt-signing
JWT_EXPIRES_IN=15m

# Refresh Token Encryption Secrets (Generate with `openssl rand -hex 32`)
REFRESH_TOKEN_SECRET=generate-a-separate-strong-random-64-character-hex-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Production Cookie Policies
# 'strict' for unified domain; 'lax' for subdomains; 'none' for cross-domain (requires secure=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# Set domain if sharing cookies across subdomains (e.g. .supportpilot.ai)
COOKIE_DOMAIN=.supportpilot.ai

# Observability
LOG_LEVEL=info

# AI Provider Gateway (Configure ONE or more providers)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-placeholder-configure-in-cloud-console
GEMINI_API_KEY=placeholder-configure-in-cloud-console
ANTHROPIC_API_KEY=placeholder-configure-in-cloud-console

# ------------------------------------------------------------------------------
# Frontend Production Settings (frontend/.env)
# ------------------------------------------------------------------------------
# In production, points to the live backend API URL
VITE_API_URL=https://api.supportpilot.ai/api
