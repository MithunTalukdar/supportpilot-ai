# ==============================================================================
# SupportPilot AI — Frontend Production Dockerfile
# Multi-stage image: Vite build followed by lightweight Nginx Alpine server
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Optimization
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source and configurations
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY index.html ./
COPY src ./src

# Accept build argument for production API URL (baked into Vite bundle)
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# Build production bundle
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: High-Performance Static Web Server (Nginx)
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner

# Remove default nginx welcome site
RUN rm -rf /usr/share/nginx/html/*

# Copy hardened nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled frontend assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
