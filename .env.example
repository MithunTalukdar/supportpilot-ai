# SupportPilot AI — Root Environment Template
# Duplicate this file into backend/.env and frontend/.env as needed.

# ==========================================
# Backend Configuration (backend/.env)
# ==========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportpilot_db?schema=public"

# Authentication & Security
JWT_SECRET=your-256-bit-jwt-secret-min-32-chars-placeholder
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars-placeholder
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging & Observability
LOG_LEVEL=info

# AI Provider Gateway (Configuration for Phase 4-6)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder
OPENAI_API_KEY=your-openai-api-key-placeholder

# ==========================================
# Frontend Configuration (frontend/.env)
# ==========================================
VITE_API_URL=http://localhost:5000/api
